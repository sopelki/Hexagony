    - target: {fileID: 2118764960772319183, guid: 727a86d465113fb4e8336b11b0aec4d5, type: 3}
      propertyPath: m_text
      value: "<color=#90CAF9><b>\u0413\u041E\u0411\u041B\u0418\u041D</b></color>:
        \u0411\u0430\u0437\u043E\u0432\u044B\u0439 \u0432\u0440\u0430\u0433 \u0438
        \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0443\u0434\u0430\u0440\u043D\u0430\u044F
        \u0441\u0438\u043B\u0430 \u043D\u0435\u0447\u0438\u0441\u0442\u0438.<line-height=20px>\r\n</line-height><line-height=60%>\u25AA\uFE0F
        <color=#dfe88b><b>\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435:</b></color>
        55\r\n\u25AA\uFE0F <color=#dfe88b><b>\u0423\u0440\u043E\u043D:</b></color>
        20\r\n\u25AA\uFE0F <color=#dfe88b><b>\u041D\u0430\u0433\u0440\u0430\u0434\u0430:</b></color>
        8\r\n</line-height><line-height=-15px>\r\n</line-height><color=#90CAF9><b>\u0413\u041E\u0411\u041B\u0418\u041D
        \u0421 \u0420\u041E\u0413\u0410\u0422\u041A\u041E\u0419</b></color>: <nobr>\u041C\u043E\u043D\u0441\u0442\u0440,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439</nobr> \u0431\u0443\u0434\u0435\u0442
        \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u0432\u0430\u0448\u0438\u0445
        \u0440\u044B\u0446\u0430\u0440\u0435\u0439.<line-height=20px>\r\n</line-height><line-height=60%>\u25AA\uFE0F
        <color=#dfe88b><b>\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435:</b></color>
        45\r\n\u25AA\uFE0F <color=#dfe88b><b>\u0423\u0440\u043E\u043D:</b></color>
        10\r\n\u25AA\uFE0F <color=#dfe88b><b>\u041D\u0430\u0433\u0440\u0430\u0434\u0430:</b></color>
        12\r\n</line-height><line-height=-15px>\r\n</line-height><color=#90CAF9><b>\u0421\u041A\u0415\u041B\u0415\u0422</b></color>:
        \u0422\u044F\u0436\u0435\u043B\u043E\u0432\u0435\u0441 \u0438 \u0441\u0430\u043C\u044B\u0439
        \u043E\u043F\u0430\u0441\u043D\u044B\u0439 <nobr>\u0438\u0437 \u0432\u0440\u0430\u0433\u043E\u0432.</nobr><line-height=20px>\r\n</line-height><line-height=60%>\u25AA\uFE0F
        <color=#dfe88b><b>\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435:</b></color>
        65\r\n\u25AA\uFE0F <color=#dfe88b><b>\u0423\u0440\u043E\u043D:</b></color>
